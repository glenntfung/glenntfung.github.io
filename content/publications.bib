% Author-name markers: Name*  = corresponding, Name# = equal contribution.

% @article{feng2026example,
%   title       = {Title of the paper},
%   author      = {Zirui Feng* and Coauthor Name},
%   journal     = {Journal Name},
%   year        = {2026},
%   doi         = {10.xxxx/xxxxx},
%   selected    = {true},
%   description = {One sentence on what the paper does.},
%   abstract    = {Full abstract text.},
% }
